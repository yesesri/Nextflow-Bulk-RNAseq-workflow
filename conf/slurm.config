process.executor = 'slurm'

// Typical cluster defaults (adjust to your site)
process.queue = 'general'
process.clusterOptions = '--account YOUR_ACCOUNT'

// Use Singularity/Apptainer on HPC
docker.enabled      = false
singularity.enabled = true
singularity.cacheDir = "${projectDir}/.singularity"

// Optional: work & results on shared FS
workDir       = "${projectDir}/work"
params.outdir = params.outdir ?: "${projectDir}/results"
